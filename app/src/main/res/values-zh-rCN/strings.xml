    <string name="about_youtube_action">在 YouTube 看 Yokuli</string>
    <string name="about_support_eyebrow">自愿支持</string>
    <string name="about_support_title">支持船员继续前进</string>
    <string name="about_support_body">Boat Watch 的完整功能永久免费。如果这个项目对你有帮助，你可以自愿支持我们继续航行、测试和开发。支持不会解锁任何 App 功能。</string>
    <string name="about_support_action">Buy Me a Coffee</string>
    <string name="about_support_unconfigured">当前构建未配置支持平台。</string>
    <string name="about_support_confirm_title">打开 Buy Me a Coffee？</string>
    <string name="about_support_confirm_body">即将离开 Boat Watch，并在浏览器中打开 Buy Me a Coffee。支持完全自愿，不会解锁任何 App 功能。</string>
    <string name="about_continue">继续</string>
